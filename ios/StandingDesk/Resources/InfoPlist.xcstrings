    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing Desk verwendet Bluetooth, um die Schreibtischhöhe abzulesen und die Bewegung zu steuern, während die App geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Standing Desk uses Bluetooth to read the desk height and control movement while the app is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing Desk usa Bluetooth para leer la altura del escritorio y controlar el movimiento mientras la app está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing Desk utilise le Bluetooth pour lire la hauteur du bureau et contrôler son mouvement lorsque l’app est ouverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing Desk usa il Bluetooth per leggere l’altezza della scrivania e controllarne il movimento mentre l’app è aperta."
          }
        }
      }
    }
